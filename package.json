{
  "name": "storeops-harness",
  "version": "0.1.0",
  "private": true,
  "description": "StoreOps retail operations API - capstone reference codebase governed by a Claude Code harness (do not use in production)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <25"
  },
  "main": "dist/index.js",
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "jest": "^30.5.2",
    "jscpd": "^5.4.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:mutation": "stryker run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "dup": "jscpd",
    "audit:deps": "npm audit --audit-level=high --omit=dev",
    "verify": "npm run typecheck && npm run lint && npm run arch && npm run dup && npm run test:coverage && npm run audit:deps",
    "perf": "node scripts/perf-smoke.js",
    "init:env": "node scripts/init-env.js",
    "smoke": "node scripts/smoke.js",
    "container:build": "podman build -t storeops-api:local .",
    "container:up": "podman compose up -d --build",
    "container:down": "podman compose down",
    "container:logs": "podman compose logs -f api",
    "start:local": "node --env-file=.env dist/index.js",
    "harness:init": "tsx .harness/tools/cli.ts init",
    "harness:checks": "tsx .harness/tools/cli.ts checks",
    "harness:verdict": "tsx .harness/tools/cli.ts verdict",
    "harness:route": "tsx .harness/tools/cli.ts route",
    "harness:runlog": "tsx .harness/tools/cli.ts runlog",
    "harness:trends": "tsx .harness/tools/cli.ts trends",
    "harness:demo": "node scripts/verdict-demo.js"
  }
}
