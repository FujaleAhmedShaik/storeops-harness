# Copy to .env for local runs. Never commit .env. Values below are placeholders.
APP_ENV=local
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Demo users (local/dev only; refused when APP_ENV=prod). Use any value of 16+ characters.
SEED_DEMO_DATA=true
DEMO_PASSWORD=
